  "slots": [
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "제XIX회 국제 자우티코프 올림피아드 / 이론시험"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "text": "쪽"
    },
    {
      "at": [
        1,
        0,
        0
      ],
      "text": "문제 3. 마그네트론 (10.0점)",
      "align": "center"
    },
    {
      "at": [
        1,
        1,
        0
      ],
      "text": "전기장과 자기장은 움직이는 대전 입자에 작용하여 그 운동의 양상을 바꾼다."
    },
    {
      "at": [
        1,
        2,
        0
      ],
      "text": "이하에서는 항상 대전 입자가 진공 속에서 움직인다고 가정하며,"
    },
    {
      "at": [
        1,
        3,
        0
      ],
      "text": "전자기파의 방출은 무시할 수 있다고 하자."
    },
    {
      "at": [
        2,
        0,
        0
      ],
      "text": "이 문제에서는 고전적인 점입자로 간주한 전자의 운동을 살펴본다. 수치 계산에서"
    },
    {
      "at": [
        2,
        1,
        0
      ],
      "text": "필요하다면 전자가 음전하를 가지며, 전하의 크기와 질량이"
    },
    {
      "at": [
        2,
        2,
        0
      ],
      "text": "다음 값을 써라. 전하 크기는"
    },
    {
      "at": [
        2,
        10,
        0
      ],
      "text": "질량은",
      "range": [
        2,
        18
      ]
    },
    {
      "at": [
        2,
        18,
        0
      ],
      "text": "전기 상수와",
      "range": [
        2,
        19
      ]
    },
    {
      "at": [
        2,
        19,
        0
      ],
      "text": "자기 상수의 값은 각각:"
    },
    {
      "at": [
        3,
        8,
        0
      ],
      "text": " 와 "
    },
    {
      "at": [
        4,
        7,
        0
      ],
      "text": "또한 볼츠만",
      "range": [
        2,
        30
      ]
    },
    {
      "at": [
        5,
        0,
        0
      ],
      "text": "상수는 다음과 같다:"
    },
    {
      "at": [
        6,
        9,
        0
      ],
      "text": "전기장과 자기장 속 전자의 운동",
      "align": "center"
    },
    {
      "at": [
        6,
        10,
        0
      ],
      "text": "처음 시각은"
    },
    {
      "at": [
        6,
        13,
        0
      ],
      "text": " 이며 전자는 좌표 원점에"
    },
    {
      "at": [
        6,
        14,
        0
      ],
      "text": "정지해 있다. 균일한 전기장의 세기는"
    },
    {
      "at": [
        6,
        14,
        2
      ],
      "text": " 이고, 방향은"
    },
    {
      "at": [
        6,
        15,
        0
      ],
      "text": "다음 축의 양의 방향:"
    },
    {
      "at": [
        6,
        15,
        2
      ],
      "text": " 축. 전자에 주는 초기 속도는"
    },
    {
      "at": [
        6,
        16,
        2
      ],
      "text": " ",
      "range": [
        2,
        7
      ]
    },
    {
      "at": [
        6,
        17,
        0
      ],
      "text": "같은 양의 축 방향이며 축은"
    },
    {
      "at": [
        6,
        17,
        2
      ],
      "text": " 축."
    },
    {
      "at": [
        7,
        0,
        1
      ],
      "text": " 운동 전체에 걸친 전자 좌표의 최댓값을 구하라:"
    },
    {
      "at": [
        7,
        3,
        0
      ],
      "text": " "
    },
    {
      "at": [
        7,
        4,
        0
      ],
      "text": "이제 처음 시각은"
    },
    {
      "at": [
        7,
        7,
        0
      ],
      "text": "전자는 좌표",
      "range": [
        2,
        32
      ]
    },
    {
      "at": [
        7,
        8,
        0
      ],
      "text": "원점에 정지해 있고, 균일한 자기장은"
    },
    {
      "at": [
        7,
        8,
        2
      ],
      "text": " "
    },
    {
      "at": [
        7,
        9,
        0
      ],
      "text": "자기장은 다음 축의 양의 방향이다:"
    },
    {
      "at": [
        7,
        9,
        2
      ],
      "text": " 축. 전자에 주는 초기"
    },
    {
      "at": [
        7,
        10,
        0
      ],
      "text": "속도는"
    },
    {
      "at": [
        7,
        11,
        2
      ],
      "text": " 이며, 다음 축의 양의 방향이다:"
    },
    {
      "at": [
        7,
        11,
        4
      ],
      "text": " 축."
    },
    {
      "at": [
        7,
        12,
        1
      ],
      "text": " 운동 전체에 걸친 전자 좌표의 최댓값을 구하라:"
    },
    {
      "at": [
        7,
        15,
        0
      ],
      "text": " "
    },
    {
      "at": [
        7,
        16,
        0
      ],
      "text": " "
    },
    {
      "at": [
        8,
        0,
        1
      ],
      "text": " 전자가 궤도를 따라 움직이던 어느 순간, 추가 속도를 준다:"
    },
    {
      "at": [
        8,
        1,
        0
      ],
      "text": "추가 속도는"
    },
    {
      "at": [
        8,
        4,
        0
      ],
      "text": " 이며, 이 속도는 당시 전자의 속도와 수직이다."
    },
    {
      "at": [
        8,
        5,
        0
      ],
      "text": "당시 속도는"
    },
    {
      "at": [
        8,
        5,
        2
      ],
      "text": " 이다. 추가 속도는 초기 궤도의 평면 안에 있으며 조건은"
    },
    {
      "at": [
        11,
        0,
        0
      ],
      "text": "이때 생긴 이차원 진동의 주기를 구하라.",
      "range": [
        2,
        73
      ]
    },
    {
      "at": [
        11,
        1,
        0
      ],
      "text": "기준은 교란되기 전 전자의 초기 궤도이다."
    },
    {
      "at": [
        12,
        0,
        0
      ],
      "text": "다시 처음 시각은"
    },
    {
      "at": [
        12,
        4,
        0
      ],
      "text": "전자가 좌표 원점에 정지해 있고 균일한 전기장의"
    },
    {
      "at": [
        12,
        5,
        0
      ],
      "text": "세기는"
    },
    {
      "at": [
        12,
        5,
        2
      ],
      "text": " 이며, 다음 축의 음의 방향이다:"
    },
    {
      "at": [
        12,
        5,
        4
      ],
      "text": " 축."
    },
    {
      "at": [
        12,
        6,
        0
      ],
      "text": "또한 균일한 자기장은"
    },
    {
      "at": [
        12,
        6,
        2
      ],
      "text": " 이고, 방향은"
    },
    {
      "at": [
        12,
        7,
        0
      ],
      "text": "다음 축의 양의 방향:"
    },
    {
      "at": [
        12,
        7,
        2
      ],
      "text": " 축. 전자는 초기 속도 영으로"
    },
    {
      "at": [
        12,
        8,
        0
      ],
      "text": "놓는다."
    },
    {
      "at": [
        13,
        0,
        1
      ],
      "text": " 운동 전체에 걸친 전자 좌표의 최댓값을 구하라:"
    },
    {
      "at": [
        13,
        3,
        0
      ],
      "text": " "
    },
    {
      "at": [
        13,
        4,
        0
      ],
      "text": "처음 시각은"
    },
    {
      "at": [
        13,
        7,
        0
      ],
      "text": " 이며 전자는 좌표"
    },
    {
      "at": [
        13,
        8,
        0
      ],
      "text": "원점에 정지해 있다. 가해진 자기장의 방향은 다음의"
    },
    {
      "at": [
        13,
        9,
        0
      ],
      "text": "축의 양의 쪽이다. 자기장"
    },
    {
      "at": [
        13,
        9,
        2
      ],
      "text": " 은 평면 "
    },
    {
      "at": [
        13,
        9,
        4
      ],
      "text": " 에서 거리로 정해진다:"
    },
    {
      "at": [
        13,
        9,
        6
      ],
      "text": " 는"
    },
    {
      "at": [
        14,
        0,
        1
      ],
      "text": " 축까지의 거리다. 법칙은"
    },
    {
      "at": [
        14,
        14,
        0
      ],
      "text": "전자에게",
      "range": [
        2,
        27
      ]
    },
    {
      "at": [
        14,
        15,
        0
      ],
      "text": "다음 축의 양의 방향으로 초기 속도를 준다:"
    },
    {
      "at": [
        14,
        15,
        2
      ],
      "text": " 축."
    },
    {
      "at": [
        15,
        0,
        1
      ],
      "text": " 전자의 최대 거리를 구하라:"
    },
    {
      "at": [
        15,
        3,
        0
      ],
      "text": " 는 다음"
    },
    {
      "at": [
        15,
        3,
        2
      ],
      "text": " 축까지로,"
    },
    {
      "at": [
        16,
        0,
        0
      ],
      "text": "운동 전체에서 구하라."
    },
    {
      "at": [
        17,
        0,
        0
      ],
      "text": "공간의 어느 영역에 축대칭인 자기장이 만들어진다."
    },
    {
      "at": [
        17,
        1,
        0
      ],
      "text": "대칭축은"
    },
    {
      "at": [
        17,
        1,
        2
      ],
      "text": " 축이다. 처음 시각"
    },
    {
      "at": [
        17,
        5,
        0
      ],
      "text": "에는 자기장이 없다.",
      "range": [
        2,
        32
      ]
    },
    {
      "at": [
        17,
        6,
        0
      ],
      "text": "그 뒤 자기장이 천천히 증가하기 시작한다. 다음"
    },
    {
      "at": [
        17,
        6,
        2
      ],
      "text": " 평면의"
    },
    {
      "at": [
        17,
        7,
        0
      ],
      "text": "모든 점에서 자기장 벡터의 방향은"
    },
    {
      "at": [
        17,
        7,
        2
      ],
      "text": " 축이다. 시간이 어느 정도"
    },
    {
      "at": [
        17,
        8,
        0
      ],
      "text": "지나면 자기장의 크기는 최종값에 도달하여 더 이상"
    },
    {
      "at": [
        17,
        9,
        0
      ],
      "text": "변하지 않는다. 최종 자기장의 분포는"
    },
    {
      "at": [
        17,
        9,
        2
      ],
      "text": " 평면에서의 값:"
    },
    {
      "at": [
