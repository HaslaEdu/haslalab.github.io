  "page": 1,
  "slots": [
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "국제 자우티코프 올림피아드",
      "substring": "Международная Жаутыковская Олимпиада"
    },
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "이론시험",
      "substring": "Теоретический тур"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "text": "쪽 ",
      "source_text": "с. "
    },
    {
      "at": [
        1,
        0,
        0
      ],
      "text": "문제 1 (10점)",
      "align": "center",
      "source_text": "Задача 1 (10 баллов) "
    },
    {
      "at": [
        1,
        1,
        0
      ],
      "text": "서로 독립인 세 부분으로 이루어진다.",
      "align": "center",
      "source_text": "Эта задача состоит из трех частей, не связанных друг с другом. "
    },
    {
      "at": [
        2,
        1,
        0
      ],
      "text": "문제 1.А. 2012 (4점)",
      "align": "center",
      "source_text": "Задача 1.А. 2012 (4 балла) "
    },
    {
      "at": [
        3,
        2,
        0
      ],
      "text": "문제 1.В. 다이오드도… (2.5점)",
      "align": "center",
      "source_text": "Задача 1.В.  И диоды…(2,5 балла) "
    },
    {
      "at": [
        8,
        0,
        0
      ],
      "text": "문제 1.С. 평면 렌즈 (3.5점)",
      "align": "center",
      "source_text": "Задача 1.С. Плоская линза (3,5 балла) "
    },
    {
      "at": [
        2,
        3,
        0
      ],
      "text": "질량이 없고 단단한 막대의 한 끝을",
      "source_text": "Один конец жёсткого невесомого стержня "
    },
    {
      "at": [
        2,
        4,
        0
      ],
      "text": "힌지로 고정한다. 다른 끝에는 질량이 없는",
      "source_text": "шарнирно закреплён, к другому концу на переки-"
    },
    {
      "at": [
        2,
        5,
        0
      ],
      "text": "도르래에 걸친 실로 추를 매달았다. 추의",
      "source_text": "нутой через невесомый блок нити подвешен груз "
    },
    {
      "at": [
        2,
        6,
        0
      ],
      "text": "질량은 ",
      "source_text": "массой "
    },
    {
      "at": [
        2,
        6,
        6
      ],
      "text": "인 두 추는",
      "source_text": " под-"
    },
    {
      "at": [
        2,
        7,
        0
      ],
      "text": "막대를 세 등분하는 두 점에 실로",
      "source_text": "вешены на нитях к стержню в точках, делящих его "
    },
    {
      "at": [
        2,
        8,
        0
      ],
      "text": "매달았다(그림 참조). 모든 실은 질량이 없고",
      "source_text": "на три равные части (см. рис.). Все нити невесомы "
    },
    {
      "at": [
        2,
        9,
        0
      ],
      "text": "늘어나지 않는다. 막대를 수평으로",
      "source_text": "и нерастяжимы. Стержень удерживают непо-"
    },
    {
      "at": [
        2,
        10,
        0
      ],
      "text": "정지시켰다가 놓는다. 막대를 놓은",
      "source_text": "движно в горизонтальном положении, а затем от-"
    },
    {
      "at": [
        2,
        11,
        0
      ],
      "text": "직후 각 추의 가속도를",
      "source_text": "пускают. Найдите ускорения грузов сразу после "
    },
    {
      "at": [
        2,
        12,
        0
      ],
      "text": "구하라.",
      "source_text": "отпускания стержня. "
    },
    {
      "at": [
        4,
        0,
        0
      ],
      "text": "별도 용지에는 다이오드 하나의 전류-",
      "source_text": "На отдельном бланке приведен график вольтам-"
    },
    {
      "at": [
        4,
        1,
        0
      ],
      "text": "전압 특성 곡선, 즉 전압에 따른",
      "source_text": "перной характеристики одного диода (зависимости си-"
    },
    {
      "at": [
        4,
        2,
        0
      ],
      "text": "다이오드 전류의 그래프(",
      "source_text": "лы тока через диод от напряжения на нем — "
    },
    {
      "at": [
        4,
        6,
        0
      ],
      "text": ")가 주어져 있다.",
      "source_text": ").  "
    },
    {
      "at": [
        4,
        7,
        0
      ],
      "text": "이와 같은 다이오드 다섯 개를",
      "source_text": "Пять таких одинаковых диодов соединены так, "
    },
    {
      "at": [
        4,
        8,
        0
      ],
      "text": "그림처럼 연결했다.",
      "source_text": "как показано на рисунке.  "
    },
    {
      "at": [
        5,
        0,
        0
      ],
      "text": "회로에 흐르는 전류와 전원의 전압 ",
      "source_text": "Постройте график зависимости силы тока в цепи "
    },
    {
      "at": [
        5,
        1,
        0
      ],
      "text": "사이의 관계를 그래프로 그려라: ",
      "source_text": "от напряжения источника "
    },
    {
      "at": [
        5,
        1,
        2
      ],
      "text": "는",
      "source_text": " , если последнее изменяет-"
    },
    {
      "at": [
        6,
        0,
        0
      ],
      "text": "그래프는 별도로 제공된 용지에 그려라.",
      "source_text": "Для построения используйте выданный вам отдельный бланк. "
    },
    {
      "at": [
        7,
        0,
        0
      ],
      "text": "이 용지도 반드시 제출하라!",
      "source_text": "Не забудьте его сдать! "
    },
    {
      "at": [
        9,
        0,
        0
      ],
      "text": "두께가 ",
      "source_text": "Круглая прозрачная плоскопараллельная пластинка толщиной "
    },
    {
      "at": [
        9,
        0,
        2
      ],
      "text": "인 투명한 원형 평행 평판이 있다.",
      "source_text": " изготовлена из мате-"
    },
    {
      "at": [
        9,
        1,
        0
      ],
      "text": "평판을 이루는 물질의 굴절률은",
      "source_text": "риала, оптический показатель преломления кото-"
    },
    {
      "at": [
        9,
        2,
        0
      ],
      "text": "평판의 중심축으로부터의 거리 ",
      "source_text": "рого зависит от расстояния "
    },
    {
      "at": [
        9,
        2,
        2
      ],
      "text": "에 따라",
      "source_text": " до центральной оси "
    },
    {
      "at": [
        9,
        3,
        0
      ],
      "text": "다음과 같이 달라진다:",
      "source_text": "пластинки по закону "
    },
    {
      "at": [
        10,
        15,
        0
      ],
      "text": "여기서 ",
      "source_text": "где "
    },
    {
      "at": [
        10,
        20,
        0
      ],
      "text": "는 주어진 양의",
      "source_text": " — известные положительные постоян-"
    },
    {
      "at": [
        10,
        21,
        0
      ],
      "text": "상수이다. 평판은 공기 중에 놓여 있고,",
      "source_text": "ные величины. Пластинка находится в воздухе, "
    },
    {
      "at": [
        10,
        22,
        0
      ],
      "text": "공기의 굴절률은 ",
      "source_text": "показатель преломления которого "
    },
    {
      "at": [
        10,
        27,
        0
      ],
      "text": "평판으로부터의 거리가 ",
      "source_text": "На оси пластинки на расстоянии "
    },
    {
      "at": [
        10,
        32,
        0
      ],
      "text": ")인 축 위의 점광원 ",
      "source_text": ") расположен точечный источник света "
    },
    {
      "at": [
        10,
        32,
        2
      ],
      "text": "가 있다.",
      "source_text": " . "
    },
    {
      "at": [
        10,
        33,
        0
      ],
      "text": "평판이 광원의 상을 만드는 일종의 렌즈임을 보여라.",
      "source_text": "Покажите, что пластинка является своеобразной линзой, то есть, формирует изображение "
    },
    {
      "at": [
        10,
        34,
        0
      ],
      "text": "광원의 상이 평판으로부터 떨어진 거리 ",
      "source_text": "источника. Определите, на каком расстоянии "
    },
    {
      "at": [
        10,
        34,
        2
      ],
      "text": "를 구하라. 광원은 ",
      "source_text": " от пластинки находится изображение источ-"
    },
    {
      "at": [
        10,
        35,
        0
      ],
      "text": "",
      "source_text": "ника "
    },
    {
      "at": [
        10,
        35,
        2
      ],
      "text": "이다. 이 렌즈의 초점 거리는 얼마인가?",
      "source_text": " . Чему равно фокусное расстояние этой линзы? "
    },
    {
      "at": [
        2,
        6,
        2
      ],
      "text": "이다. 또 질량이 ",
      "substring": ". Ещё два груза массами "
    },
    {
      "at": [
        2,
        6,
        4
      ],
      "text": "과 ",
      "substring": " и "
    },
    {
      "at": [
        5,
        2,
        0
      ],
      "text": "",
      "substring": "ся от "
    },
    {
      "at": [
        5,
        2,
        0
      ],
      "text": "부터 ",
      "substring": " до "
    },
    {
      "at": [
        5,
        2,
        0
      ],
      "text": "까지 변한다.",
      "substring": ". "
    }
  ],
