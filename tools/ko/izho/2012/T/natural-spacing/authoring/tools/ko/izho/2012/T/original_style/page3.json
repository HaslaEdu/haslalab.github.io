        10,
        4
      ],
      "text": "와 ",
      "source_text": " и "
    },
    {
      "at": [
        3,
        16,
        0
      ],
      "text": ". 수치값도 구하라: ",
      "source_text": ". Найдите численное значение "
    },
    {
      "at": [
        3,
        18,
