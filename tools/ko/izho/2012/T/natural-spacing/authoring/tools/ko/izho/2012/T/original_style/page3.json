      "at": [
        2,
        4,
        0
      ],
      "text": "이고,",
      "substring": " и "
    },
    {
      "at": [
        2,
        16,
        0
      ],
      "text": "이고 온도는 ",
      "substring": " и температуре "
    },
    {
      "at": [
        2,
        20,
        0
      ],
      "text": "이다.",
      "substring": ". "
    },
    {
      "at": [
        2,
        25,
        0
      ],
      "text": "이다. 용기 벽과 피스톤은",
      "substring": ". Стенки сосуда и поршень изготов-"
    },
