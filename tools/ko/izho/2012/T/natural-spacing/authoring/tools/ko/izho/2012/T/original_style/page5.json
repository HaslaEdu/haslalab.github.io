  "native_prose_tokens": [
    "VIII",
    "arcsin",
    "crtitcal",
    "deformed"
  ],
  "journal_selected_prose_whitespace": true,
  "staging_only_prose_baseline": true,
  "page": 4,
  "slots": [
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "국제 자우티코프 올림피아드",
      "substring": "Международная Жаутыковская Олимпиада"
    },
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "이론시험",
      "substring": "Теоретический тур"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "text": "쪽 ",
      "source_text": "с. "
    },
    {
      "at": [
        1,
        0,
        1
      ],
      "source_text": "обменная энергия взаимодействия, отражающая тенденцию к стабильности ядер с ",
      "text": "다음 조건에서 핵이 안정해지려는 경향을 반영하는 교환 상호작용 에너지:"
    },
    {
      "at": [
        1,
        5,
        1
      ],
      "source_text": "прямая зависимость от числа нуклонов ",
      "text": "핵력에 의해 핵자 수 "
    },
    {
      "at": [
        1,
        5,
        3
      ],
      "source_text": " вследствие действия ядерных сил.  ",
      "text": "에 정비례하는 에너지."
    },
    {
      "at": [
        1,
        6,
        0
      ],
      "source_text": "Также в выводе этой полуэмпирической формулы Вайцзеккер использовал экспери-",
      "text": "바이츠제커는 이 반경험적 공식을 유도할 때 실험으로 확인된"
    },
    {
      "at": [
        1,
        7,
        0
      ],
      "source_text": "ментально установленную зависимость радиуса атомного ядра от числа нуклонов ",
      "text": "핵자 수에 따른 원자핵 반지름의 관계도 이용했다:"
    },
    {
      "at": [
        3,
        0,
        0
      ],
      "source_text": "где ",
      "text": "여기서 "
    },
    {
      "at": [
        3,
        2,
        1
      ],
      "source_text": " – некоторая константа. ",
      "text": "은 상수이다."
    },
    {
      "at": [
        4,
        0,
        0
      ],
      "source_text": "Основываясь на всем вышеизложенном, дайте ответы на следующие вопросы: ",
      "text": "위 내용을 바탕으로 다음 물음에 답하라:"
    },
    {
      "at": [
        4,
        1,
        1
      ],
      "source_text": "[2 балла]",
      "text": "[2점]"
    },
    {
      "at": [
        4,
        1,
        2
      ],
      "source_text": " Найдите электростатическую энергию ",
      "text": "정전기 에너지 "
    },
    {
      "at": [
        4,
        3,
        1
      ],
      "source_text": " шара радиуса ",
      "text": "를 구하라. 반지름이 "
    },
    {
      "at": [
        4,
        3,
        3
      ],
      "source_text": ", равномерно заря-",
      "text": "이고 전하가"
    },
    {
      "at": [
        4,
        4,
        0
      ],
      "source_text": "женного по объёму зарядом ",
      "text": "구 전체에 균일하게 분포하며, 총전하가 "
    },
    {
      "at": [
        4,
        4,
        2
      ],
      "source_text": ". Ответ выразите через заряд ",
      "text": "인 구이다. 답을 전하 "
    },
    {
      "at": [
        4,
        4,
        4
      ],
      "source_text": ", диэлектрическую постоянную ",
      "text": ", 진공 유전율 "
    },
    {
      "at": [
        5,
        1,
        1
      ],
      "source_text": " и радиус шара ",
      "text": ", 반지름 "
    },
    {
      "at": [
        5,
        2,
        1
      ],
      "source_text": "[1 балл] ",
      "text": "[1점] "
    },
    {
      "at": [
        5,
        2,
        2
      ],
      "source_text": "Найдите численное значение коэффициента ",
      "text": "다음 계수의 수치를 구하라: "
    },
    {
      "at": [
        5,
        4,
        1
      ],
      "source_text": " в формуле (3). ",
      "text": " (식 (3))."
    },
    {
      "at": [
        5,
        5,
        1
      ],
      "source_text": "[1 балл] ",
      "text": "[1점] "
    },
    {
      "at": [
        5,
        5,
        2
      ],
      "source_text": "Найдите численное значение плотности ядерного вещества ",
      "text": "핵물질의 밀도 수치를 구하라: "
    },
    {
      "at": [
        5,
        8,
        1
      ],
      "source_text": "[1 балл] ",
      "text": "[1점] "
    },
    {
      "at": [
        5,
        8,
        2
      ],
      "source_text": "Найдите численное значение коэффициента поверхностного натяжения ",
      "text": "핵자 액체의 표면 장력 계수 "
    },
    {
      "at": [
        5,
        8,
        4
      ],
      "source_text": " нук-",
      "text": "의"
    },
    {
      "at": [
        5,
        9,
        0
      ],
      "source_text": "лонной жидкости. ",
      "text": "수치를 구하라."
    },
    {
      "at": [
        6,
        0,
        0
      ],
      "source_text": "Допустим теперь, что ядро делится на две части с атомными весами ",
      "text": "이제 핵이 원자량이 각각 "
    },
    {
      "at": [
        6,
        0,
        2
      ],
      "source_text": " и ",
      "text": "와 "
    },
    {
      "at": [
        6,
        4,
        0
      ],
      "source_text": ", где ",
      "text": "인 두 조각으로 나뉜다고 하자."
    },
    {
      "at": [
        6,
        9,
        1
      ],
      "source_text": ". Можно считать, что и заряд ядра, и число нейтронов между осколками распреде-",
      "text": "이다. 각 조각의 전하와 중성자 수도 원자량과 같은 비율로"
    },
    {
      "at": [
        6,
        10,
        0
      ],
      "source_text": "ляются также как и атомный вес. ",
      "text": "분배된다고 보아도 된다."
    },
    {
      "at": [
        6,
        11,
        1
      ],
      "source_text": "[2 балла]",
      "text": "[2점]"
    },
    {
      "at": [
        6,
        11,
        2
      ],
      "source_text": " Деление ядра становится энергетически выгодным при выполнении условия ",
      "text": "핵분열이 에너지 면에서 유리해지는 조건은"
    },
    {
      "at": [
        7,
        6,
        0
      ],
      "source_text": ". Найдите выражение для функции ",
      "text": "이다. 함수 "
    },
    {
      "at": [
        7,
        8,
        2
      ],
      "source_text": " и постройте ее схематический график. ",
      "text": "의 식을 구하고 그래프의 개형을 그려라."
    },
    {
      "at": [
        7,
        9,
        1
      ],
      "source_text": "[0.5 балла] ",
      "text": "[0.5점] "
    },
    {
      "at": [
        7,
        9,
        2
      ],
      "source_text": "С точностью до двух значащих цифр найдите предельное значение ",
      "text": "자발 핵분열이 이론적으로 가능한 한계값 "
    },
    {
      "at": [
        7,
        17,
        0
      ],
      "source_text": "при котором самопроизвольное деление еще теоретически возможно. ",
      "text": "을 유효숫자 두 자리까지 구하라."
    },
    {
      "at": [
        8,
        0,
        0
      ],
      "source_text": "При выполнении условия из п. 3.5 ядро может существовать достаточно долго. ",
      "text": "3.5의 조건을 만족해도 핵은 충분히 오래 존재할 수 있다."
    },
    {
      "at": [
        8,
        1,
        0
      ],
      "source_text": "Например, период полураспада ядра урана-235 равен 713 миллионов лет. Следовательно, ",
      "text": "예를 들어 우라늄-235 핵의 반감기는 7억 1300만 년이다. 따라서"
    },
    {
      "at": [
        8,
        2,
        0
      ],
      "source_text": "мгновенному делению ядер препятствует некоторый энергетический барьер, который исче-",
      "text": "핵이 즉시 분열하는 것을 막는 에너지 장벽이 있으며, 이 장벽은"
    },
    {
      "at": [
        9,
        0,
        0
      ],
      "source_text": "зает при некотором критическом значении ",
      "text": "다음 임계값에서 사라진다: "
    },
    {
      "at": [
        9,
        7,
        0
      ],
      "source_text": ". В действи-",
      "text": ". 실제로"
    },
    {
      "at": [
        9,
        8,
        0
      ],
      "source_text": "тельности, ядро начнет делиться только при значительном отклонении ",
      "text": "핵은 구형에서 크게 벗어난 변형을 겪어야"
    },
    {
      "at": [
        9,
        9,
        0
      ],
      "source_text": "его формы от сферической. ",
      "text": "분열하기 시작한다."
    },
    {
      "at": [
        10,
        0,
        0
      ],
      "source_text": "Для простоты примем, что сферическое ядро испытывает такие ",
      "text": "단순화를 위해 구형 핵이 변형되어"
    },
    {
      "at": [
        10,
        1,
        0
      ],
      "source_text": "деформации, при которых его поверхность становится поверхностью ",
      "text": "표면이 장축을 중심으로 한 회전타원체가"
    },
    {
      "at": [
        10,
        2,
        0
      ],
      "source_text": "вытянутого эллипсоида вращения, который в декартовых координатах ",
      "text": "된다고 하자. 이 곡면은 직교좌표계에서"
    },
    {
      "at": [
        10,
        3,
        0
      ],
      "source_text": "описывается уравнением ",
      "text": "다음 식으로 나타낼 수 있다:"
    },
    {
      "at": [
        13,
        0,
        0
      ],
      "source_text": "где ",
      "text": "여기서 "
    },
    {
      "at": [
        13,
        0,
        2
      ],
      "source_text": " – малая, а ",
      "text": "는 단반경, "
    },
    {
      "at": [
        13,
        0,
        4
      ],
      "source_text": " – большая полуоси эллипсоида соответственно. ",
      "text": "는 장반경이다."
    },
    {
      "at": [
        13,
        2,
        0
      ],
      "source_text": "Объем вытянутого эллипсоида вращения определяется выражением ",
      "text": "장축을 중심으로 한 회전타원체의 부피는"
    },
    {
      "at": [
        15,
        0,
        0
      ],
      "source_text": "а площадь его поверхности может быть вычислена по формуле ",
      "text": "이며, 그 표면적은 다음 식으로 계산할 수 있다:"
    },
    {
      "at": [
        20,
        1,
        0
      ],
      "source_text": "Пусть сферическое ядро испытывает такую деформацию, что ",
      "text": "구형 핵이 변형되어 "
    },
    {
      "at": [
        20,
        9,
        0
      ],
      "source_text": " и ",
      "text": "와 "
    },
    {
      "at": [
        20,
        17,
        0
      ],
      "source_text": ", причем  ",
      "text": "가 된다고 하자. 이때 "
    },
    {
      "at": [
        20,
        23,
        0
      ],
      "source_text": ", а ",
      "text": "이고, "
    },
    {
      "at": [
        20,
        23,
        2
      ],
      "source_text": " – начальный радиус ядерной капли. ",
      "text": "은 핵 액적의 초기 반지름이다."
    },
    {
      "at": [
        20,
        24,
        1
      ],
      "source_text": "[0.5 балла]",
      "text": "[0.5점]"
    },
    {
      "at": [
        20,
        24,
        2
      ],
      "source_text": " Найдите соотношение между ",
      "text": "다음 두 양의 관계를 구하라: "
    },
    {
      "at": [
        20,
        24,
        4
      ],
      "source_text": " и ",
      "text": "와 "
    },
    {
      "at": [
        5,
        1,
        3
      ],
      "source_text": " . ",
      "text": "로 표현하라."
    }
  ],
