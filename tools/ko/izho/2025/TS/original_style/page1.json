  "source_sha256": "9b4bbf5fdf1a4d763a379665c199e55164e3878918bae9871e6c42695374df83",
  "small_glyph_heights": true,
  "engine": "izho_early_fixed_style",
  "page": 0,
  "slots": [
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "제XXI회 국제 자우티코프 올림피아드 / 이론시험"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "text": "쪽"
    },
    {
      "at": [
        1,
        0,
        0
      ],
      "text": "이론시험 문제 해설",
      "align": "center"
    },
    {
      "at": [
        2,
        0,
        0
      ],
      "text": "주의. 채점 점수는 나누어 주지 않는다!",
      "align": "center"
    },
    {
      "at": [
        3,
        0,
        0
      ],
      "text": "문제 1 (10.0점)",
      "align": "center"
    },
    {
      "at": [
        3,
        1,
        0
      ],
      "text": "문제 1.1 (3.0점)",
      "align": "center"
    },
    {
      "at": [
        3,
        2,
        0
      ],
      "text": "질량이"
    },
    {
      "at": [
        3,
        2,
        2
      ],
      "text": "인 우주선이 지표면에서 출발한다고 하자. 무한히 멀리 가려면"
    },
    {
      "at": [
        3,
        3,
        0
      ],
      "text": "총에너지가 영이 되는 제2우주속도를 가져야 한다:"
    },
    {
      "at": [
        10,
        0,
        0
      ],
      "text": "이때"
    },
    {
      "at": [
        10,
        0,
        2
      ],
      "text": "는 중력 상수이다. 식 (1)로부터 제2우주속도를 나타내는 다음 식을"
    },
    {
      "at": [
        10,
        1,
        0
      ],
      "text": "얻을 수 있다:"
    },
    {
      "at": [
        14,
        0,
        0
      ],
      "text": "이제 지구 기준계에서 달의 공전 속력"
    },
    {
      "at": [
        14,
        0,
        3
      ],
      "text": "을 구하자. 이를 위해 다음과 같이"
    },
    {
      "at": [
        14,
        1,
        0
      ],
      "text": "뉴턴 제2법칙을 적용한다:"
    },
    {
      "at": [
        18,
        12,
        0
      ],
      "text": "이때 중력 상호작용의 힘은 뉴턴의 만유인력 법칙으로 정해진다:"
    },
    {
      "at": [
        21,
        11,
        0
      ],
      "text": "식 (3), (4)로 구한 달의 공전 속력에 식 (2)를 사용하면 다음과 같이"
    },
    {
      "at": [
        21,
        12,
        0
      ],
      "text": "쓸 수 있다:"
    },
    {
      "at": [
        26,
        0,
        0
      ],
      "text": "우주선이 달에서 충분히 멀리 떨어져 달의 중력을 무시할 수 있는 곳에서 달의 궤도를"
    },
    {
      "at": [
        26,
        1,
        0
      ],
      "text": "지난다고 하자. 우주선의 지구에 대한 속력"
    },
    {
      "at": [
        26,
        1,
        2
      ],
      "text": "을 이 교차 순간에 구하면 에너지 보존 법칙에 따라 다음과"
    },
    {
      "at": [
        26,
        2,
        0
      ],
      "text": "같이 된다:"
    },
    {
      "at": [
        30,
        12,
        0
      ],
      "text": "따라서"
    },
    {
      "at": [
        34,
        0,
        0
      ],
      "text": "달 기준계에서 우주선의 속력"
    },
    {
      "at": [
        34,
        0,
        2
      ],
      "text": "은 달의 공전 궤도에 들어선 이후의 값이다. 이 값은"
    },
    {
      "at": [
        34,
        1,
        0
      ],
      "text": "우주선과 달의 속도 벡터 차로 정해진다."
    },
    {
      "at": [
        34,
        2,
        0
      ],
      "text": "그 최솟값은 다음과 같다:"
    },
    {
      "at": [
        35,
        10,
        0
      ],
      "text": "최댓값은 다음과 같다:"
    },
    {
      "at": [
        36,
        10,
        0
      ],
      "text": "구하려는 양을 계산하기 위해 달에 고정된 기준계로 옮겨 에너지 보존 법칙을"
    },
    {
      "at": [
        36,
        11,
        0
      ],
      "text": "다음 형태로 적용한다:"
    },
    {
      "at": [
        51,
        0,
        0
      ],
      "text": "그리고 달의 제2우주속도"
    },
    {
      "at": [
        51,
        0,
        3
      ],
      "text": "를 도입하면"
    },
    {
      "at": [
        58,
        0,
        0
      ],
      "text": "마지막으로 구하려던 우주선의 속력은 다음과 같다:"
    },
    {
      "at": [
        64,
        0,
        0
      ],
      "text": "내용",
      "align": "center"
    },
    {
      "at": [
        64,
        1,
        0
      ],
      "text": "점수",
      "align": "center"
    }
  ]
}
