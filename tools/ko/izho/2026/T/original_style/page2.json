  "slots": [
    {
      "at": [
        0,
        0,
        0
      ],
      "text": "제22회 국제 자우티코프 올림피아드 / 이론시험"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "text": "쪽"
    },
    {
      "at": [
        1,
        1,
        0
      ],
      "text": "이 문제는 독립적인 세 부분으로 구성된다.",
      "align": "center"
    },
    {
      "at": [
        2,
        2,
        0
      ],
      "text": "가느다란 원통 심의 반지름은"
    },
    {
      "at": [
        2,
        2,
        2
      ],
      "text": "이며, 포일 띠가 얇게 감겨 있다."
    },
    {
      "at": [
        2,
        3,
        0
      ],
      "text": "팽팽히 감긴 포일의 두께는"
    },
    {
      "at": [
        2,
        3,
        2
      ],
      "text": ", 질량"
    },
    {
      "at": [
        2,
        3,
        4
      ],
      "text": ", 길이는"
    },
    {
      "at": [
        2,
        3,
        6
      ],
      "after": "m",
      "text": ". 한쪽 끝을"
    },
    {
      "at": [
        2,
        4,
        0
      ],
      "text": "심에 고정하고, 반대쪽 끝은 얇은 수평 평판의 가장자리에 붙인다."
    },
    {
      "at": [
        2,
        5,
        0
      ],
      "text": "평판을"
    },
    {
      "at": [
        2,
        5,
        2
      ],
      "text": "라 하자. 처음에 두루마리(심과 감긴 포일)를 잡아 그 축"
    },
    {
      "at": [
        2,
        5,
        4
      ],
      "text": "를"
    },
    {
      "at": [
        2,
        6,
        0
      ],
      "text": "수평으로 평판과 같은 높이에 둔다. 놓아 주면 중력으로 인해"
    },
    {
      "at": [
        2,
        7,
        0
      ],
      "text": "두루마리의 포일이 풀리기 시작한다. 조건"
    },
    {
      "at": [
        2,
        7,
        2
      ],
      "text": "이면 풀린 길이"
    },
    {
      "at": [
        2,
        7,
        5
      ],
      "text": "를"
    },
    {
      "at": [
        2,
        8,
        0
      ],
      "text": "구하라. 이때 풀린 포일이 주는 힘"
    },
    {
      "at": [
        2,
        8,
        3
      ],
      "text": "는 평판에 작용하며, 크기는"
    },
    {
      "at": [
        2,
        9,
        0
      ],
      "text": "두루마리의 무게"
    },
    {
      "at": [
        2,
        9,
        2
      ],
      "text": "와 같다. 이때 가속도"
    },
    {
      "at": [
        2,
        9,
        4
      ],
      "text": "와 속도"
    },
    {
      "at": [
        2,
        9,
        6
      ],
      "text": "를"
    },
    {
      "at": [
        2,
        10,
        0
      ],
      "text": "두루마리 질량중심의 아래 방향 운동에 대하여 구하라.",
      "extend_to": 461.0
    },
    {
      "at": [
        3,
        1,
        0
      ],
      "before": "(Ω)",
      "text": "저항계 모드의 멀티미터"
    },
    {
      "at": [
        3,
        1,
        0
      ],
      "after": "(Ω)",
      "text": "를 연결한다. 그 표시값은"
    },
    {
      "at": [
        3,
        2,
        0
      ],
      "text": "시간에 따라 다음 법칙으로 바뀐다:"
    },
    {
      "at": [
        3,
        3,
        4
      ],
      "text": "여기서"
    },
    {
      "at": [
        3,
        3,
        12
      ],
      "text": "및"
    },
    {
      "at": [
        3,
        3,
        16
      ],
      "after": "s",
      "text": "이다."
    },
    {
      "at": [
        3,
        4,
        0
      ],
      "text": "이 자료를 이용하여 저항 두 개의 값"
    },
    {
      "at": [
        3,
        4,
        2
      ],
      "text": "과"
    },
    {
      "at": [
        3,
        4,
        4
      ],
      "text": "및 축전기"
    },
    {
      "at": [
        3,
        5,
        0
      ],
      "text": "의 전기용량"
    },
    {
      "at": [
        3,
        5,
        2
      ],
      "text": "를 구하라. 처음에는 충전되지 않았다."
    },
    {
      "at": [
        3,
        6,
        0
      ],
      "text": "또한 발생한 열량"
    },
    {
      "at": [
        3,
        6,
        2
      ],
      "text": "를 구하라. 저항"
    },
    {
      "at": [
        3,
        6,
        4
      ],
      "text": "에서 발생하며"
    },
    {
      "at": [
        3,
        7,
        0
      ],
      "text": "측정 시간은"
    },
    {
      "at": [
        4,
        0,
        0
      ],
      "text": "주:",
      "italic": true
    },
    {
      "at": [
        4,
        0,
        1
      ],
      "text": "저항계 모드에서 멀티미터는 전압 강하"
    },
    {
      "at": [
        4,
        1,
        2
      ],
      "text": "를 미지의 저항"
    },
    {
      "at": [
        4,
        1,
        5
      ],
      "text": "양단에서 잰다. 전류"
    },
    {
      "at": [
        4,
        2,
        0
      ],
      "text": "를 일정하게 흘릴 때 표시되는 값은"
    },
    {
      "at": [
        5,
        1,
        0
      ],
      "text": "관찰자의 눈이 볼록·오목 렌즈에서"
    },
    {
      "at": [
        5,
        1,
        2
      ],
      "after": "cm",
      "text": "떨어져 있다."
    },
    {
      "at": [
        5,
        2,
        0
      ],
      "text": "멀리 있는 가로등의 빛이 렌즈의 두 면에서 반사되어"
    },
    {
      "at": [
        5,
        3,
        0
      ],
      "text": "만드는 상을 관찰한다(사진 참조). 눈과 가로등은 렌즈의"
    },
    {
      "at": [
        5,
        4,
        0
      ],
      "text": "오목한 면 쪽에서 주광축 가까이에 놓여 있다."
    },
    {
      "at": [
        5,
        5,
        0
      ],
      "text": "이 렌즈의 오목한 면의 곡률반지름은"
    },
    {
      "at": [
        5,
        5,
        2
      ],
      "after": "cm",
      "text": "이다. 한편,"
    },
    {
      "at": [
        5,
        6,
        0
      ],
      "text": "볼록한 면의 곡률반지름은"
    },
    {
      "at": [
        5,
        6,
        2
      ],
      "after": "cm",
      "text": "이다. 두 상 중에서"
    },
    {
      "at": [
        5,
        7,
        0
      ],
      "text": "하나는 실상이고 다른 하나는 허상이다. 두 상의 겉보기"
    },
    {
      "at": [
        5,
        8,
        0
      ],
      "text": "각크기의 비는"
    },
    {
      "at": [
        5,
        8,
        6
      ],
      "text": "이며,"
    },
    {
      "at": [
        5,
        8,
        9
      ],
      "text": "은 실상의 각크기,"
    },
    {
      "at": [
        5,
        9,
        0
      ],
      "text": "그리고"
    },
    {
      "at": [
        5,
        9,
        3
      ],
      "text": "는 허상의 각크기이다. 이 렌즈의 굴절능"
    },
    {
      "at": [
        5,
        10,
        1
      ],
      "text": "를 구하라."
    }
  ],
