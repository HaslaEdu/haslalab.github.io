      ],
      "text": " 국제 자우티코프 올림피아드 ",
      "source_text": " International Zhautykov Olympiad ",
      "substring": " International Zhautykov Olympiad "
    },
    {
      "at": [
        0,
        2,
        0
      ],
      "text": "이론시험 / 해설 ",
      "source_text": "Theoretical Competition/Solutions ",
      "substring": "Theoretical Competition/Solutions "
    },
    {
      "at": [
