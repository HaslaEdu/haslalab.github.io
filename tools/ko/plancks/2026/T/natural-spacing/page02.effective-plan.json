        152.1339569091797,
        576.0437622070312,
        162.0965576171875
      ],
      "point": [
        55.926300048828125,
        159.9200439453125
      ],
      "font": "CMR10",
      "size": 9.962599754333496,
      "text": "총 9문항입니다. 마지막 문항은 5점이며 나머지는 각 10점입니다."
    },
    {
      "id": "p2:b4:l1:s0-18",
      "page": 2,
      "at": [
        4,
        1,
