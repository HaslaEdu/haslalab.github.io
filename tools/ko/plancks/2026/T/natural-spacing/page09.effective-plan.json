        449.28399658203125,
        394.6709289550781,
        474.7683410644531,
        404.6335144042969
      ],
      "point": [
        449.28399658203125,
        402.4570007324219
      ],
      "font": "CMR10",
      "size": 9.962599754333496,
      "text": "단,"
    },
    {
      "id": "p9:b12:l0:s4-4",
      "page": 9,
      "at": [
        12,
        0,
        4,
        4
      ],
