      "rect": [
        484.99993896484375,
        394.6709289550781,
        575.978515625,
        404.6335144042969
      ],
      "point": [
        484.99993896484375,
        402.4570007324219
      ],
      "font": "CMR10",
      "size": 9.962599754333496,
      "text": "는 관의 단면적"
    },
    {
      "id": "p9:b12:l1:s0-40",
      "page": 9,
      "at": [
        12,
        1,
        0,
        40
