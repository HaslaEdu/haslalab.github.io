      ],
      "font": "CMR10",
      "size": 9.962599754333496,
      "text": ": 이 성질에 의해 리드가 악기에 맞는 진동수를 만들어 내는 원리를 정성적으로 설명하라."
    },
    {
      "id": "p9:b10:l0:s0-34",
      "page": 9,
      "at": [
        10,
        0,
        0,
        34
      ],
      "source": "In the ideal case, sound waves moving down the instrument perfectly reflect at the bottom of the instrument.",
      "rect": [
        36.0,
        381.52001953125,
        513.8064575195312,
        391.48260498046875
      ],
      "point": [
        36.0,
        389.30609130859375
