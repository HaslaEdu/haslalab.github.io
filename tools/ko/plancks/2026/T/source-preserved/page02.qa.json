      ],
      "angle": 0.0,
      "color": 0
    },
    {
      "id": "p2:b5:l3:s0-20",
      "text": "모든 답안지에 표시해야 채점할 수 있습니다.",
      "source_font": "CMR10",
      "font_role": "serif",
      "size": 9.962599754333496,
