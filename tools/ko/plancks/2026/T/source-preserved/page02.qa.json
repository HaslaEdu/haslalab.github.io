      "angle": 0.0,
      "color": 0
    },
    {
      "id": "p2:b4:l1:s0-18",
      "text": "세부 배점은 각 문항에 표시되어 있습니다.",
      "source_font": "CMR10",
      "font_role": "serif",
      "size": 9.962599754333496,
      "point": [
        60.90699768066406,
        173.070068359375
