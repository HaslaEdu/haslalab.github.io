      ],
      "angle": 0.0,
      "color": 0
    },
    {
      "id": "p2:b5:l1:s0-44",
      "text": "한 장의 앞면에 한 문항을, 뒷면에 다른 문항을 푸는 것도 허용하지 않습니다.",
      "source_font": "CMR10",
      "font_role": "serif",
      "size": 9.962599754333496,
      "point": [
        60.90699768066406,
        207.342041015625
