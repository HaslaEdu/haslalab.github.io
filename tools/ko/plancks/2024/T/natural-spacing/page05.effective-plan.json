        121.35475158691406,
        280.7366638183594,
        132.26385498046875
      ],
      "size": 10.909099578857422,
      "font": "SFRM1095",
      "font_role": "serif",
      "text": "해밀턴은 사원수를 다음과 같이 표기했다:"
    },
    {
      "id": "p5:b4:l0:s0-16",
      "page": 5,
      "at": [
        4,
        0,
        0,
        16
      ],
