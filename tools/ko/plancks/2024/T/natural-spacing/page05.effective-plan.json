        105.16583251953125
      ],
      "size": 10.909099578857422,
      "font": "SFRM1095",
      "font_role": "serif",
      "text": "사원수로 확장해야 함을 보였다."
    },
    {
      "id": "p5:b2:l0:s0-10",
      "page": 5,
      "at": [
        2,
        0,
        0,
        10
      ],
      "source": "Hamilton had a notation for quaternions",
