  "__slot_edits__": {
    "p60:b2:l0:s3-3": {
      "text": " 다음 시약으로 쓸 수 있는 물질을 모두:"
    },
    "p60:b4:l0:s4-4": {
      "text": " 레보부피바카인의 구조를 적절한 입체 화학과 함께."
    },
    "p60:b7:l1:s0-0": {
      "text": "레보부피바카인 합성에는 광학적으로 순수한"
    },
    "p60:b7:l2:s0-0": {
      "text": "거울상 순도는 흔히 모셔산으로 아마이드화해 확인한다"
    },
    "p60:b7:l3:s0-0": {
      "text": "(아래의 ("
    },
    "p60:b8:l1:s3-3:c0-44": {
      "text": " 아마이드 구조를:"
    },
    "p60:b8:l1:s3-3:c45-61": {
      "text": "-아미노기 유도체이며, 원료는 ",
      "join_left": true
    },
    "p60:b8:l1:s5-5": {
      "text": "-라이신, 시약은 ",
      "join_left": true
    },
    "p60:b11:l0:s5-5": {
      "text": ")-모셔산의 반응으로 생기는가(라이신의"
    },
    "p60:b11:l1:s0-0:c10-51": {
      "text": "-아미노기만 유도체화된다고 가정)?",
      "join_left": true
    },
    "p60:b13:l0:s3-3": {
      "text": " 라이신 유도체화 후 거울상 순도를 정량할 방법을."
    },
    "p60:b13:l1:s0-0": {
      "text": "유도체화 시약은 ("
    },
    "p60:b7:l1:s2-2": {
      "join_left": true
    },
    "p60:b3:l0:s1-1:c0-9": {
      "source_word_right_aligned_label": true
