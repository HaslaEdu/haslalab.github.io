  "__slot_edits__": {
    "p39:b8:l0:s0-0": {
      "text": "서로 다른 고분자 블록을 연결한 공중합체는 자기 조립 능력 같은"
    },
    "p39:b8:l1:s0-0": {
      "text": "독특한 성질이 있다. 여기서는 이 고분자의 합성과"
    },
    "p39:b10:l1:s0-0": {
      "text": "첫 부분에서는 수용성 단독 중합체"
    },
    "p39:b10:l2:s0-0": {
      "text": "아미노폴리에틸렌글리콜)을 연구한다."
    },
    "p39:b10:l3:s0-0": {
      "text": "다음 "
    },
    "p39:b10:l3:s2-2:c5-18": {
      "text": "스펙트럼을 보이는 화합물은"
    },
    "p39:b10:l3:s7-7:c16-50": {
      "text": ")이다:"
    },
    "p39:b19:l0:s5-5": {
