  "__slot_edits__": {
    "p8:b10:l0:s0-0": {
      "text": "이 계는 전자가 자유로운 1차원 상자("
    },
    "p8:b10:l0:s2-2": {
      "text": "무한 우물)로 모형화할 수 있다."
    },
    "p8:b14:l0:s8-8": {
      "text": "을 각각의"
    },
    "p8:b16:l0:s1-1:c7-22": {
      "text": "전자는 양 끝 결합에"
    },
    "p8:b16:l1:s0-0": {
      "text": "국소화되어 분리된 두 무한 퍼텐셜 우물에서"
    },
    "p8:b16:l2:s0-0": {
      "text": "운동한다. 각 우물의 길이:"
    },
    "p8:b17:l0:s1-1:c7-22": {
      "text": "전자는 분자 전체에"
    },
    "p8:b17:l1:s0-0": {
      "text": "비편재화되어 한 무한 퍼텐셜 우물에서"
    },
    "p8:b17:l2:s0-0:c0-43": {
      "text": "운동한다. 우물의 길이:"
    },
    "p8:b11:l0:s2-2": {
      "text": "인 무한 우물 속 전자의 에너지:"
    },
    "p8:b8:l0:s0-0:c0-9": {
      "join_right": true
    },
    "p8:b8:l0:s0-0:c12-45": {
      "join_left": true
    },
    "p8:b14:l0:s4-4": {
      "text": "적어도 가장 낮은 세 에너지 준위"
    },
