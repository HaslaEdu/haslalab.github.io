        554.0193481445312,
        574.1953125
      ],
      "point": [
        178.41461181640625,
        571.5686645507812
      ],
      "font": "SFRM1200",
      "size": 11.9552001953125,
      "dir": [
        1.0,
        0.0
      ],
      "text": "가 흐른다. 둘째 고리를"
