        534.5513305664062
      ],
      "point": [
        200.572998046875,
        531.9246826171875
      ],
      "font": "SFRM1200",
      "size": 11.9552001953125,
      "dir": [
        1.0,
        0.0
      ],
      "text": "가 작용한다. 첫 고리는 고정하고, 저항"
