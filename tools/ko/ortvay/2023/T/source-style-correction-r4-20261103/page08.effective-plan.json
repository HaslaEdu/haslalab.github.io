        565.8963623046875,
        407.194091796875,
        577.8515625
      ],
      "point": [
        343.1739807128906,
        575.2249145507812
      ],
      "font": "SFRM1200",
      "size": 11.9552001953125,
      "dir": [
        1.0,
        0.0
      ],
      "text": "에서"
    },
    {
      "id": "p8:b12:l2:s26-33",
      "page": 8,
      "at": [
        12,
        2,
        26,
        33
      ],
      "source": " infinitely far in the",
      "rect": [
        446.7212219238281,
        565.8963623046875,
        553.9247436523438,
        577.8515625
      ],
      "point": [
        446.7212219238281,
        575.2249145507812
      ],
      "font": "SFRM1200",
      "size": 11.9552001953125,
      "dir": [
        1.0,
        0.0
      ],
      "text": "까지, 무한히 먼"
    },
    {
      "id": "p8:b12:l3:s0-4",
      "page": 8,
      "at": [
        12,
        3,
        0,
        4
      ],
      "source": "vacuum of space.",
      "rect": [
        72.91799926757812,
        577.4503784179688,
        160.13119506835938,
