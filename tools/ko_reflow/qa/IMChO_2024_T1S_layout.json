  "font_size": 11.86,
  "lines": 1,
  "rect": [
   56.6399040222168,
   514.5325927734375,
   106.401123046875,
   529.3793334960938
  ]
 },
 {
  "page": 13,
  "text": "4) 옥테인 연소:",
