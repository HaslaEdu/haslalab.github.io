   538.2357177734375,
   538.5200805664062,
   553.2437133789062
  ]
 },
 {
  "page": 5,
  "text": "처음 시료에서의 질량 분율:",
  "font_size": 13.0,
  "lines": 1,
  "rect": [
   56.8,
   589.4,
   231,
   605.1
  ]
 },
 {
  "page": 5,
